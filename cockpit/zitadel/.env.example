# Copy to .env (gitignored — the root .gitignore's `.env` rule covers it) and fill.
# Secrets never get committed. The live copy belongs beside the live checkout's compose file.
#
# Generate strong values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24)[:32])"   # masterkey (32 chars exactly)
#   python -c "import secrets; print(secrets.token_urlsafe(24))"        # each password
ZITADEL_MASTERKEY=CHANGE-ME-32-CHARS-EXACTLY-00000    # EXACTLY 32 characters (Zitadel refuses anything else)
ZITADEL_DB_ADMIN_PASSWORD=CHANGE-ME                   # postgres superuser (container-internal only)
ZITADEL_DB_USER_PASSWORD=CHANGE-ME                    # zitadel's own DB user
ZITADEL_ADMIN_INITIAL_PASSWORD=CHANGE-ME              # first login for user `owner` — change is forced on first login
