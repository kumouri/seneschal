# cockpit/server/cockpit.env — real OIDC auth config. Copy this file to `cockpit.env` (gitignored —
# the root .gitignore's `**/cockpit.env` rule covers it) once you've provisioned an OIDC app.
#
# NOTE: the full OIDC auth stack (the /auth/login round trip, session issuance, break-glass) is a
# DEFERRED follow-up — this build ships dev-no-auth only. Leave COCKPIT_OIDC_CLIENT_ID unset until
# that lands: setting it flips `auth.auth_mode()` to "oidc", and without the login routes every
# gated route would just 401.
#
# Mode precedence (auth.py::auth_mode): if COCKPIT_OIDC_CLIENT_ID is set here (or in the environment),
# real OIDC auth is used; else COCKPIT_DEV_NO_AUTH=1 falls back to the dev stub; else every gated
# route 503s "auth not configured". Never put real secrets in the committed .example file (there IS
# no client secret to put — the app registers as a PKCE/public client).

# The OIDC provider's issuer URL (no path suffix — discovery finds the rest via
# <issuer>/.well-known/openid-configuration).
COCKPIT_OIDC_ISSUER=http://localhost:8480

# The cockpit's registered OIDC application's Client ID (authorization code + PKCE, NO secret). No
# default: an empty value here is exactly what keeps `auth_mode()` from returning "oidc" until the
# deferred auth stack lands and this is filled in.
COCKPIT_OIDC_CLIENT_ID=

# Must match the redirect URI registered on the OIDC app EXACTLY (path included).
COCKPIT_OIDC_REDIRECT=http://127.0.0.1:8760/auth/callback

# The single allowed cockpit user — checked against the OIDC userinfo response's `preferred_username`
# (or its @-local-part) / `sub`. Anyone else gets a polite, audited 403.
COCKPIT_ALLOWED_USER=owner

# NOT a config var here on purpose: the session-cookie signing secret
# (cockpit/server/session.py::get_or_create_secret) is auto-generated to a gitignored
# <state_dir>/cockpit-session-secret on first use — never hand-set, never an env var, so it can't end
# up in a doc, a shell history, or a backup of this file.
