# Front-door Router (Advisor Chain — Router advisor, phase 1 shadow). Free-but-local.
# Copy to router.env (gitignored) and adjust only if your Ollama isn't on the default host/port
# or you want a different local classifier model / confidence bar. All values have safe defaults
# baked into router.py, so router.env is optional.

# Where the local Ollama server listens.
OLLAMA_URL=http://localhost:11434

# The local classifier model (pull once: `ollama pull qwen3.5:4b`). Small + fast — it runs in the
# daemon on every inbound chat message before the warm Opus session spins.
ROUTER_MODEL=qwen3.5:4b

# Minimum confidence to accept a "trivial" verdict. Below this, the message escalates (safe default).
# Abstain ⇒ escalate: the bar is deliberately high in phase 1 while we gather shadow accuracy data.
# The steer arm reuses this same bar for a "steer" verdict (below it, the message holds).
ROUTER_CONF_THRESHOLD=0.7

# --- the steer arm (mid-turn relevance gate) + shared keep-alive ------------------------------
# The steer arm fires rarely (only when a message lands while a turn is running), so its calls are
# often cold model loads that time out into the safe `hold` fallback rather than rendering a real
# verdict. These knobs give it its own model/timeout and keep the router model resident longer.
# All three are optional; each default matches the other arms' behaviour.

# A smaller/faster model for THIS arm only (empty = fall back to ROUTER_MODEL). Pull it first and
# compare verdict quality before switching.
ROUTER_STEER_MODEL=

# Per-call timeout for the steer arm, in seconds (the other arms use 20 as well).
ROUTER_STEER_TIMEOUT=20

# How long Ollama keeps ANY router model resident after a call (Ollama's own `keep_alive` field).
# Applied to every arm's call, not just steer's — a sparse arm lands past Ollama's own 5-minute
# default idle-unload, so each call is a cold load unless other traffic keeps the model warm.
# Ollama's own default is "5m"; this raises it (trades idle VRAM for fewer cold loads).
ROUTER_KEEP_ALIVE=30m
