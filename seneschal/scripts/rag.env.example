# Local RAG index (Advisor Chain, phase B) — free-but-local embeddings.
# Copy to rag.env (gitignored) and adjust only if your Ollama isn't on the default
# host/port or you want a different local embed model. All values have safe defaults
# baked into rag_common.py, so rag.env is optional.

# Where the local Ollama server listens.
OLLAMA_URL=http://localhost:11434

# The local embedding model (pull once: `ollama pull nomic-embed-text`).
EMBED_MODEL=nomic-embed-text

# Chunking: target chars per chunk and overlap between chunks.
CHUNK_CHARS=800
CHUNK_OVERLAP=150
