# Home Assistant REST API — copy to ha.env (gitignored) and fill in.
# Without this file the presence action layer is INERT (nothing calls out). See HA_SETUP.md.
#
# HA_URL:   your HA base URL — e.g. http://homeassistant.local:8123, or a Tailscale/LAN IP:8123.
# HA_TOKEN: a long-lived access token (HA -> your profile -> Long-Lived Access Tokens -> Create Token).
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
