# Copy to `push-call.env` (git-ignored) and fill in real values.
# Enables the assistant to place a phone call to the owner (can't-miss reminders) via a
# call-screener Worker's POST /push-call endpoint (deployed separately). Twilio creds stay
# in Cloudflare — only the Worker URL + bearer secret live here. Sibling of push-sms.env.

# Full endpoint URL (the deployed Worker; include /push-call).
PUSH_CALL_URL=https://your-call-screener.YOUR-SUBDOMAIN.workers.dev/push-call

# Must match `wrangler secret put PUSH_CALL_SECRET` on the Worker.
PUSH_CALL_SECRET=the-long-random-string-you-set-on-the-worker

# Optional. Recipient E.164. Omit to let the Worker default to its USER_CELL_E164.
# PUSH_CALL_TO=+15125551234
