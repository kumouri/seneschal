# Copy to proton.env (untracked) and fill in from Proton Mail Bridge.
# Bridge → click the assistant's account → "Mailbox details" shows host, ports, username, password.

# IMPORTANT: do NOT put an inline "# comment" after a value below — everything after '=' becomes the value.
# Username: use EXACTLY what Bridge "Mailbox details" shows (often the PRIMARY account address, not the assistant's alias).
PROTON_BRIDGE_USER=assistant@example.com
# Password: the Bridge-GENERATED mailbox password (~24 chars), NOT your Proton login password.
PROTON_BRIDGE_PASS=

# Defaults usually work; override only if Bridge shows different values.
PROTON_SMTP_HOST=127.0.0.1
PROTON_SMTP_PORT=1025
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143
PROTON_SENDER=assistant@example.com

# Bridge uses a local self-signed cert by default; keep these at 1 unless you've installed Bridge's CA.
PROTON_SMTP_STARTTLS=1
PROTON_SMTP_INSECURE=1
PROTON_IMAP_STARTTLS=1
PROTON_IMAP_INSECURE=1
