# Telegram bot credentials for the assistant — copy to telegram.env and fill in (telegram.env is gitignored).
# Setup walkthrough: TELEGRAM_SETUP.md
# Gotcha: no inline "# comment" after a value — the whole line after = is the value.

# From @BotFather when you create the bot (looks like 123456789:AA...). Required.
TELEGRAM_BOT_TOKEN=

# The owner's chat id with the bot — the default recipient for pushes/replies.
# Find it: message the bot once, then run  python telegram_poll.py --env-file telegram.env
# and read chat_id from the output.
TELEGRAM_CHAT_ID=

# Optional allowlist for inbound polling (comma-separated chat ids). If set, telegram_poll.py only
# returns messages from these chats. Strongly recommended — usually just TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional. The literal parse_mode handed to the Bot API: "" (plain), "MarkdownV2", or "HTML".
# Plain is safest — MarkdownV2 requires escaping many characters, and one missed character is a 400,
# which means the message is DROPPED. Leave this empty and use TELEGRAM_FORMAT below instead.
TELEGRAM_PARSE_MODE=

# Optional. Converts the assistant's Markdown to Telegram HTML at the send boundary: "plain"
# (default — Markdown arrives verbatim with literal ** in it) or "markdown".
# Set it to markdown to turn formatting on; set it back to plain to roll it straight back.
# A rejected conversion is re-sent once as plain text with the original string, so a bad render
# costs the formatting and never the message. Details + the limits: TELEGRAM_SETUP.md.
TELEGRAM_FORMAT=

# Optional. Override only for a proxy or test harness.
TELEGRAM_API_BASE=https://api.telegram.org
