# Copy to `push-sms.env` (git-ignored) and fill in real values.
# Enables the assistant's scheduler to SMS the owner brief highlights via a call-screener
# Worker's POST /push-sms endpoint (deployed separately). Twilio creds stay in Cloudflare
# — only the Worker URL + bearer secret live here.

# Full endpoint URL (the deployed Worker, no trailing slash issues — include /push-sms).
PUSH_SMS_URL=https://your-call-screener.YOUR-SUBDOMAIN.workers.dev/push-sms

# Must match `wrangler secret put PUSH_SMS_SECRET` on the Worker.
PUSH_SMS_SECRET=the-long-random-string-you-set-on-the-worker

# Optional. Recipient E.164. Omit to let the Worker default to its USER_CELL_E164.
# PUSH_SMS_TO=+15125551234
