# Copy to `discord.env` (git-ignored) and fill in real values.
# Enables the assistant's two-way Discord channel (outbound discord_send.py + inbound
# discord_poll.py). Free; needs a Discord bot in a private channel the assistant watches.
# Setup: DISCORD_SETUP.md.

# Bot token from the Discord Developer Portal (Bot → Reset Token). Secret — never commit.
DISCORD_BOT_TOKEN=your-bot-token

# The channel id the assistant posts in and watches (right-click the channel → Copy Channel ID;
# requires Developer Mode enabled in Discord settings).
DISCORD_CHANNEL_ID=123456789012345678

# Allowlist of author ids allowed to drive the assistant (comma-separated). Set to your own
# Discord user id so only you can talk to it. Bot messages are always ignored.
DISCORD_ALLOWED_USER_IDS=234567890123456789

# Override only for a proxy/test. Default is the current stable API version.
# DISCORD_API_BASE=https://discord.com/api/v10
