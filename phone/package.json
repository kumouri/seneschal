{
  "name": "seneschal-screener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tiered, cost-optimized AI call screener — Twilio ConversationRelay + Claude on Cloudflare Workers.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply:local": "wrangler d1 execute call_screener --local --file=./src/data/schema.sql",
    "db:apply:remote": "wrangler d1 execute call_screener --remote --file=./src/data/schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.106.0"
  }
}
